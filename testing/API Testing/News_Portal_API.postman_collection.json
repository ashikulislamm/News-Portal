    {
      "name": "News Articles (CRUD)",
      "item": [
        {
          "name": "Create News Post (Save ID & Slug)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Testing Principles 2026\",\n  \"description\": \"An article describing software testing verification workflows and bug trackers.\",\n  \"content\": \"<p>Testing is integral to software development lifecycles. Maintaining test suites saves time.</p>\",\n  \"category\": \"Technology\",\n  \"tags\": \"QA, Testing, Software\",\n  \"keywords\": \"QA, Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/news",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "news"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Article created successfully and dynamic keys saved\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"News posted successfully!\");",
                  "    pm.expect(jsonData.news._id).to.be.a('string');",
                  "    pm.expect(jsonData.news.slug).to.be.a('string');",
                  "    ",
                  "    // Save dynamic IDs for downstream GET / PUT / DELETE testing",
                  "    pm.environment.set(\"created_post_id\", jsonData.news._id);",
                  "    pm.environment.set(\"created_post_slug\", jsonData.news.slug);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
